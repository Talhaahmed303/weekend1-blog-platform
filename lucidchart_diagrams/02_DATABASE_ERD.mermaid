%% =============================================================================
%% FALCONXOFT INTERN EVALUATION — PROJECT 01: BLOG PLATFORM
%% Entity Relationship Diagram (ERD) (Lucidchart / Mermaid Compatible)
%% Candidate: Talha Ahmed | Date: October 2026
%% =============================================================================

erDiagram
    AUTHENTICATION_USER {
        bigserial id PK "Primary Key"
        varchar username UK "Unique Username (150)"
        varchar email UK "Email Address (254)"
        varchar password "Hashed Password (PBKDF2/Argon2)"
        varchar role "Role: 'author' or 'admin'"
        text bio "Author Biography"
        varchar avatar_url "Avatar Image URL"
        boolean is_active "Account Active Status"
        boolean is_staff "Django Admin Staff Status"
        timestamptz date_joined "Account Registration Timestamp"
    }

    POSTS_CATEGORY {
        bigserial id PK "Primary Key"
        varchar name UK "Category Title (100)"
        varchar slug UK "URL Friendly Slug (120)"
        text description "Category Overview"
        timestamptz created_at "Creation Timestamp"
    }

    POSTS_POST {
        bigserial id PK "Primary Key"
        bigint author_id FK "References AUTHENTICATION_USER.id (CASCADE)"
        bigint category_id FK "References POSTS_CATEGORY.id (SET NULL)"
        varchar title "Article Title (255)"
        varchar slug UK "Unique Article Slug (300)"
        text content "Full Article Body (Markdown/Text)"
        varchar excerpt "Short Summary (500)"
        varchar status "Lifecycle State: 'draft' or 'published'"
        text cover_image "Image URL or Base64 Data URI"
        timestamptz published_at "Publication Timestamp (NULL for drafts)"
        timestamptz created_at "Creation Timestamp"
        timestamptz updated_at "Last Modified Timestamp"
    }

    COMMENTS_COMMENT {
        bigserial id PK "Primary Key"
        bigint post_id FK "References POSTS_POST.id (CASCADE)"
        bigint author_id FK "References AUTHENTICATION_USER.id (CASCADE)"
        text content "Comment Body Text"
        timestamptz created_at "Comment Timestamp"
    }

    %% Relationships & Cardinalities
    AUTHENTICATION_USER ||--o{ POSTS_POST : "authors (1:N)"
    POSTS_CATEGORY ||--o{ POSTS_POST : "classifies (1:N)"
    AUTHENTICATION_USER ||--o{ COMMENTS_COMMENT : "writes (1:N)"
    POSTS_POST ||--o{ COMMENTS_COMMENT : "contains (1:N)"
