# Django Backend Settings
DEBUG=True
DJANGO_SECRET_KEY=falconxoft-eval-secret-key-change-in-production-2026
ALLOWED_HOSTS=*

# PostgreSQL Database Configuration
DB_NAME=blog_db
DB_USER=postgres
