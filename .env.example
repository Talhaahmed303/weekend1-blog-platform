ACCESS_TOKEN_LIFETIME_MINUTES=1440
REFRESH_TOKEN_LIFETIME_DAYS=7

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001/api
